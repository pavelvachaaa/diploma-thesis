@startuml
left to right direction
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false

actor "Uchazeč" as Candidate
actor "Nový zaměstnanec" as Employee
actor "HR pracovník" as HR
actor "Vedoucí oddělení" as Manager
actor "Centrální administrátor" as CentralAdmin

rectangle "Platforma náboru a adaptace" {

  rectangle "Kariérní portál\n(React / Next.js)" as Portal
  rectangle "Interní administrační UI\n(React)" as AdminUI
  rectangle "Backend služby\n(Node / API)" as Core

  rectangle "CV processor\n(Python service)" as CVP
  rectangle "Job processor\n(Python service)" as JOBP
  rectangle "LLM inference service\n(Ollama)" as OLLAMA
}

rectangle "SSO / identitní služba" as Identity
rectangle "NRZP (cílová integrace)" as Registry
rectangle "Notifikační kanály\n(email / push)" as Notify
rectangle "Observability stack\n(Prometheus / Grafana / Loki)" as Obs

Candidate --> Portal
Employee --> Portal
HR --> AdminUI
Manager --> AdminUI
CentralAdmin --> AdminUI

Portal --> Core
AdminUI --> Core

Core --> Identity
Core --> Registry
Core --> CVP
Core --> JOBP

CVP --> OLLAMA
JOBP --> OLLAMA

Core --> Notify
Core --> Obs
@enduml