@startuml
top to bottom direction
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 40

package "Organizace a identita" #EEF2FF {
  entity "organizations" as ORG {
    * id : uuid
    --
    name : varchar
    seat_location : varchar(3)
  }
  entity "users" as USR {
    * id : uuid
    --
    + organization_id : uuid
    + applicant_id : uuid
    email : varchar
    onboarding_workflow_id : uuid
  }
  entity "organization_memberships" as MEM {
    * id : uuid
    --
    + user_id : uuid
    + role_id : uuid
    + organization_id : uuid
    expires_at : timestamptz
  }
  entity "user_roles" as ROLE {
    * id : uuid
    --
    name : varchar
  }
}

package "Pracovní pozice" #F0FFF0 {
  entity "job_postings" as JP {
    * id : uuid
    --
    + organization_id : uuid
    + job_role_id : uuid
    + onboarding_workflow_id : uuid
    title : varchar
    status : text
    expire_date : date
  }
  entity "job_roles" as JR {
    * id : uuid
    --
    + organization_id : uuid
    name : varchar
  }
  entity "job_embeddings" as JE {
    * id : uuid
    --
    + job_posting_id : uuid
    embedding : vector(768)
  }
}

package "Nábor — uchazeči" #FFFBF0 {
  entity "applicants" as APP {
    * id : uuid
    --
    + job_posting_id : uuid
    + organization_id : uuid
    name, surname : varchar
    current_status : varchar
    applied_at : timestamptz
  }
  entity "application_attachments" as ATT {
    * id : uuid
    --
    + applicant_id : uuid
    file_path : text
    mime_type : varchar
  }
  entity "cv_analyses" as CVA {
    * id : uuid
    --
    + applicant_id : uuid
    + organization_id : uuid
    skills : text[]
    evaluation_score : integer
    embedding : vector(768)
  }
}

package "Pohovory" #FFF0F0 {
  entity "interview_events" as INT {
    * id : uuid
    --
    + applicant_id : uuid
    + organization_id : uuid
    scheduled_at : timestamptz
    location : text
    status : text
  }
  entity "interview_participants" as INTP {
    * id : uuid
    --
    + interview_id : uuid
    + user_id : uuid
  }
}

package "Onboarding" #F0FAFF {
  entity "onboarding_workflows" as OW {
    * id : uuid
    --
    + organization_id : uuid
    name : varchar
    is_active : boolean
  }
  entity "onboarding_steps" as OS {
    * id : uuid
    --
    + workflow_id : uuid
    form : jsonb
    step_type : text
  }
  entity "user_onboarding_steps" as UOS {
    * id : uuid
    --
    + user_id : uuid
    + onboarding_step_id : uuid
    status : text
    form_response : jsonb
    completed_at : timestamptz
  }
  entity "user_documents" as UDOC {
    * id : uuid
    --
    + user_id : uuid
    + document_type_id : uuid
    file_path : text
    approval_status : text
  }
}

package "Zájemci o práci" #F5F0FF {
  entity "job_seekers" as JS {
    * id : uuid
    --
    + organization_id : uuid
    name, email : varchar
  }
  entity "job_seeker_cv_analyses" as JSCA {
    * id : uuid
    --
    + job_seeker_id : uuid
    embedding : vector(768)
  }
}

package "Platforma" #F5F5F5 {
  entity "side_effect_outbox" as OUTBOX {
    * id : uuid
    --
    event_type : text
    payload : jsonb
    status : text
    attempt_count : integer
    next_attempt_at : timestamptz
  }
  entity "audit_events" as AUDIT {
    * id : uuid
    --
    actor_id : uuid
    action : text
    entity_type : text
    organization_id : uuid
    created_at : timestamptz
  }
}

' Organizace a identita
ORG ||--o{ USR
ORG ||--o{ MEM
MEM }o--|| ROLE
USR ||--o{ MEM

' Pracovní pozice
ORG ||--o{ JP
ORG ||--o{ JR
JP }o--|| JR
JP ||--o{ JE

' Nábor
JP ||--o{ APP
APP ||--o{ ATT
APP ||--o{ CVA

' Uchazeč → zaměstnanec
APP |o--o| USR

' Pohovory
APP ||--o{ INT
INT ||--o{ INTP
USR ||--o{ INTP

' Onboarding
ORG ||--o{ OW
JP }o--|| OW
OW ||--o{ OS
OS ||--o{ UOS
USR ||--o{ UOS
USR ||--o{ UDOC

' Zájemci
ORG ||--o{ JS
JS ||--o{ JSCA

@enduml
