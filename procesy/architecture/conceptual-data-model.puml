@startuml
!pragma layout smetana
top to bottom direction
hide stereotype

skinparam backgroundColor transparent
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam defaultTextAlignment center
skinparam arrowFontSize 13
skinparam dpi 160
skinparam ranksep 24
skinparam nodesep 18
skinparam ArrowColor #475569
skinparam ArrowThickness 1.0
skinparam RoundCorner 14

skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}

skinparam rectangle<<frontend>> {
  BackgroundColor #EAF2FF
  BorderColor #2B5AA6
}

skinparam rectangle<<service>> {
  BackgroundColor #E8FFF8
  BorderColor #0F766E
}

skinparam rectangle<<external>> {
  BackgroundColor #F1F5F9
  BorderColor #64748B
}

skinparam rectangle<<obs>> {
  BackgroundColor #EEF2FF
  BorderColor #4F46E5
}

skinparam rectangle<<data>> {
  BackgroundColor #FFF3E0
  BorderColor #C97A10
  FontColor #7C2D12
}

title Zjednodušený model hlavních datových entit

package "Organizační rámec" {
  rectangle "Organizace" <<data>> as ORG
  rectangle "Interní uživatel / zaměstnanec,\nčlenství a oprávnění" <<data>> as USR
}

package "Nábor" {
  rectangle "Pracovní role" <<data>> as ROLE
  rectangle "Pracovní pozice" <<data>> as JOB
  rectangle "Uchazeč" <<data>> as APP
  rectangle "Pohovor" <<data>> as INT
}

package "Adaptace" {
  rectangle "Adaptační postup" <<data>> as WF
  rectangle "Průběh adaptace\nzaměstnance" <<data>> as PROG
  rectangle "Dokument zaměstnance" <<data>> as DOC
}

ORG --> JOB : vypisuje
ORG --> WF : spravuje
ORG --> USR : vymezuje členství
USR --> JOB : má oprávnění k
ROLE --> JOB : typizuje
JOB --> APP : přijímá reakce
APP --> INT : vede k
APP --> USR : po přijetí se převádí

JOB --> WF : používá
USR --> PROG : plní
WF --> PROG : podle postupu
USR --> DOC : předkládá
WF ..> DOC : může vyžadovat

ORG -[hidden]-> USR
ROLE -[hidden]-> JOB
JOB -[hidden]-> APP
APP -[hidden]-> INT
WF -[hidden]-> PROG
PROG -[hidden]-> DOC

@enduml
