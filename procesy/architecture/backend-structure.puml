@startuml
top to bottom direction
hide stereotype

skinparam backgroundColor transparent
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultTextAlignment center
skinparam dpi 160
skinparam ranksep 28
skinparam nodesep 26
skinparam ArrowColor #475569
skinparam ArrowThickness 1.0
skinparam RoundCorner 14

skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}

skinparam rectangle<<frontend>> {
  BackgroundColor #EAF2FF
  BorderColor #2B5AA6
}

skinparam rectangle<<service>> {
  BackgroundColor #E8FFF8
  BorderColor #0F766E
}

skinparam rectangle<<external>> {
  BackgroundColor #F1F5F9
  BorderColor #64748B
}

skinparam rectangle<<obs>> {
  BackgroundColor #EEF2FF
  BorderColor #4F46E5
}

skinparam database {
  BackgroundColor #FFF3E0
  BorderColor #C97A10
  FontColor #7C2D12
}

skinparam folder {
  BackgroundColor #FFF3E0
  BorderColor #C97A10
  FontColor #7C2D12
}

skinparam queue {
  BackgroundColor #FFF3E0
  BorderColor #C97A10
  FontColor #7C2D12
}

title Návrh hranic backendu v hexagonálním uspořádání

package "Vstupní adaptéry" {
  rectangle "HTTP vstupy a controllery" <<frontend>> as ROUTES
  rectangle "Vstupní middleware\nkontext, validace, autentizace" <<frontend>> as MW
  rectangle "Konzumenti událostí\n a SSE vstupy" <<frontend>> as CONSUMERS
}

package "Doménové jádro a use-cases" {
  package "Ohraničené kontexty" {
    rectangle "Uchazeči" <<service>> as M_APP
    rectangle "Pracovni pozice" <<service>> as M_JOBS
    rectangle "Pohovory" <<service>> as M_INT
    rectangle "Zaměstnanci a adaptace" <<service>> as M_EMP
    rectangle "Notifikace a provozní logika" <<service>> as M_OTHER
  }

  rectangle "Port kontrakty" as PORTS
}

package "Sekundární adaptéry" {
  rectangle "Datové adaptéry" as ADB
  rectangle "Messaging a outbox" as AOUTBOX
  rectangle "Dokumenty a e-mail" as ASTORAGE
  rectangle "Autentizace a autorizace" as ASEC
  rectangle "Integrace s okolními službami" as AINT
  rectangle "Auditní adaptér" as AAUDIT
}

rectangle "Composition root\n a DI kontejner" <<obs>> as DI

database "Relační databáze" as DB
folder "Objektové úložiště" as S3
queue "Message broker" as MQ
rectangle "Identitní provider" <<external>> as SSO
rectangle "Externí registry a interní služby" <<external>> as EXT
rectangle "E-mailová infrastruktura" <<external>> as SMTP

ROUTES --> MW
MW --> M_APP
MW --> M_JOBS
MW --> M_INT
MW --> M_EMP
MW --> M_OTHER
CONSUMERS --> M_APP
CONSUMERS --> M_JOBS
CONSUMERS --> M_OTHER

M_APP --> PORTS
M_JOBS --> PORTS
M_INT --> PORTS
M_EMP --> PORTS
M_OTHER --> PORTS

PORTS --> ADB
PORTS --> AOUTBOX
PORTS --> ASTORAGE
PORTS --> ASEC
PORTS --> AINT
PORTS --> AAUDIT

ADB --> DB
AOUTBOX --> MQ
ASTORAGE --> S3
ASTORAGE --> SMTP
ASEC --> SSO
AINT --> EXT
AAUDIT --> MQ

DI ..> M_APP
DI ..> M_JOBS
DI ..> M_INT
DI ..> M_EMP
DI ..> M_OTHER
DI ..> ADB
DI ..> AOUTBOX
DI ..> ASTORAGE
DI ..> ASEC
DI ..> AINT
DI ..> AAUDIT

M_APP -[hidden]right-> M_JOBS
M_JOBS -[hidden]right-> M_INT
M_INT -[hidden]right-> M_EMP
M_EMP -[hidden]right-> M_OTHER
ADB -[hidden]right-> AOUTBOX
AOUTBOX -[hidden]right-> ASTORAGE
ASTORAGE -[hidden]right-> ASEC
ASEC -[hidden]right-> AINT
AINT -[hidden]right-> AAUDIT

@enduml
