@startuml
top to bottom direction
hide stereotype

skinparam backgroundColor transparent
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam defaultTextAlignment center
skinparam arrowFontSize 13
skinparam dpi 160
skinparam ranksep 28
skinparam nodesep 22
skinparam ArrowColor #475569
skinparam ArrowThickness 1.0
skinparam RoundCorner 14

skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}

skinparam rectangle<<frontend>> {
  BackgroundColor #EAF2FF
  BorderColor #2B5AA6
}

skinparam rectangle<<service>> {
  BackgroundColor #E8FFF8
  BorderColor #0F766E
}

skinparam rectangle<<external>> {
  BackgroundColor #F1F5F9
  BorderColor #64748B
}

skinparam actor {
  BorderColor #64748B
  FontColor #0F172A
}

together {
  actor "Uchazeč" as Candidate
  actor "HR pracovník" as HR
  actor "Vedoucí zaměstnanec" as Manager
  actor "Nastupující zaměstnanec" as Employee
  actor "Správce systému" as Admin
}

rectangle "Platforma náboru a adaptace KZ" {
  package "Vstupní portály" {
    together {
      rectangle "Kariérní\nportál" <<frontend>> as CareerPortal
      rectangle "Administrační\nportál" <<frontend>> as AdminPortal
      rectangle "Onboardingový\nportál" <<frontend>> as OnboardingPortal
    }
  }

  rectangle "Transakční a integrační jádro" <<service>> as Core
}

together {
  rectangle "SSO / OIDC" <<external>> as SSO
  rectangle "NRZP\n(ověření kvalifikace)" <<external>> as NRZP
  rectangle "SMTP server\n(transakční e-maily)" <<external>> as SMTP
  rectangle "Vema\n(personální data)\n[R5 - plánováno]" <<external>> as Vema
}

Candidate ..> CareerPortal
HR ..> AdminPortal
HR ..> OnboardingPortal
Manager ..> AdminPortal
Manager ..> OnboardingPortal
Employee ..> OnboardingPortal
Admin ..> AdminPortal

CareerPortal --> Core
AdminPortal --> Core
OnboardingPortal --> Core

Core --> SSO : přihlášení
Core --> NRZP
Core --> SMTP
Core --> Vema

Candidate -[hidden]right-> HR
HR -[hidden]right-> Manager
Manager -[hidden]right-> Employee
Employee -[hidden]right-> Admin

CareerPortal -[hidden]right-> AdminPortal
AdminPortal -[hidden]right-> OnboardingPortal

SSO -[hidden]right-> NRZP
NRZP -[hidden]right-> SMTP
SMTP -[hidden]right-> Vema

Candidate -[hidden]down-> CareerPortal
HR -[hidden]down-> AdminPortal
Employee -[hidden]down-> OnboardingPortal
CareerPortal -[hidden]down-> Core
Core -[hidden]down-> NRZP

@enduml
