<?xml version="1.0" encoding="utf-8"?>
<archimate:model xmlns:archimate="http://www.archimatetool.com/archimate" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="KZ Onboarding Suite - Core" id="model-simplified" version="4.9.0">
  
  <folder name="Business" id="folder-biz" type="business">
