@startuml
left to right direction
hide stereotype

skinparam backgroundColor transparent
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultTextAlignment center
skinparam dpi 160
skinparam ranksep 28
skinparam nodesep 26
skinparam ArrowColor #475569
skinparam ArrowThickness 1.0
skinparam RoundCorner 14

skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}

skinparam rectangle<<primary>> {
  BackgroundColor #EAF2FF
  BorderColor #2B5AA6
}

skinparam rectangle<<core>> {
  BackgroundColor #E8FFF8
  BorderColor #0F766E
}

skinparam rectangle<<secondary>> {
  BackgroundColor #FFF3E0
  BorderColor #C97A10
  FontColor #7C2D12
}

skinparam actor {
  BorderColor #334155
  FontColor #0F172A
}

skinparam database {
  BackgroundColor #FFF3E0
  BorderColor #C97A10
  FontColor #7C2D12
}

skinparam queue {
  BackgroundColor #FFF3E0
  BorderColor #C97A10
  FontColor #7C2D12
}

title Hexagonální princip backendu

actor "Uživatel / jiný systém / test" as ACTOR
rectangle "Primární adaptéry\nHTTP, CLI, event consumer,\ntest harness" <<primary>> as PRIMARY

package "Uvnitř aplikace" {
  rectangle "Vstupní porty\n(use-cases)" as INPORTS
  rectangle "Aplikační jádro\n(doména + aplikační služby)" <<core>> as CORE
  rectangle "Výstupní porty\n(repozitáře, audit,\nintegrace, messaging)" as OUTPORTS
}

rectangle "Sekundární adaptéry\nDB, broker, externí API,\nstorage, audit transport" <<secondary>> as SECONDARY
database "Databáze" as DB
queue "Message broker" as MQ
rectangle "Externí služby" <<secondary>> as EXT

ACTOR --> PRIMARY
PRIMARY --> INPORTS
INPORTS --> CORE
CORE --> OUTPORTS
OUTPORTS --> SECONDARY
SECONDARY --> DB
SECONDARY --> MQ
SECONDARY --> EXT
@enduml
