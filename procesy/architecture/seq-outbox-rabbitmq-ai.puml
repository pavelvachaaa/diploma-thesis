@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial

actor "HR/Admin" as user
participant "Backend API\n(hiring_backend)" as api
database "PostgreSQL" as db
participant "Outbox Worker" as worker
queue "RabbitMQ" as mq
participant "cv_processor" as cv
participant "job_processor" as job
participant "Host vrstvy inteligentního\nzpracování dat\n(Ollama, A10 24 GB)" as ollama

worker -> db: 0) LISTEN side_effect_outbox
user -> api: create/update use case
api -> db: BEGIN
api -> db: write business data
api -> db: insert side_effect_outbox
api -> db: COMMIT
api -> db: 4a) NOTIFY side_effect_outbox

alt Primarni probuzeni pres LISTEN/NOTIFY
  db --> worker: 4b) wake-up notification
  worker -> db: 5) select pending outbox rows
else Fallback pri ztrate notifikace nebo po restartu workeru
  loop fallback polling
    worker -> db: 5) select pending outbox rows
  end
end
  db --> worker: rows
  alt CV pipeline
    worker -> mq: 6) publish cv.publish.*
    mq -> cv: consume event
    cv -> ollama: 7) analysis/embeddings
    cv -> mq: 8) publish cv.analyzed
    mq -> api: consume result event
    api -> db: 9) persist cv_analyses
  else Job pipeline
    worker -> mq: 6) publish job.embedding.requested
    mq -> cv: consume embedding request
    cv -> ollama: 7) generate job embedding
    cv -> mq: 8) publish job.embedding.completed
    mq -> api: consume result event
    api -> db: 9) persist job_embeddings
  end
  worker -> db: 10) mark outbox as sent/dead

note over worker, db
LISTEN/NOTIFY je primarni mechanismus probuzeni workeru.
Polling zustava aktivni jako bezpecny fallback pri restartu
procesu nebo pri ztrate databazove notifikace.
end note

@enduml
