@startuml
skinparam shadowing false
actor "Vývojář" as Dev
participant "Gitea repozitář" as Repo
participant "Gitea Actions runner" as Runner
database "Container registry\n(docker.kzcr.eu)" as Registry
participant "Deploy bundle\n(compose.yaml, env, skripty)" as Bundle
participant "Cílový host" as Host
participant "Docker Compose" as Compose
participant "Migrační služba\n(jen backend)" as Migration
participant "Kontejner služby" as App

Dev -> Repo: push změn a release tagu vX.Y.Z
Repo -> Runner: trigger workflow na refs/tags/vX.Y.Z
Runner -> Runner: validace tagu, testy a build image
Runner -> Registry: push ${REGISTRY_IMAGE}:${TAG}
Runner -> Bundle: vytvoření deploy bundle
Runner -> Host: SSH/SCP upload bundle
Runner -> Host: vzdálené spuštění deploy příkazů
Host -> Registry: docker login
Host -> Host: ensure app-network exists
Host -> Compose: compose pull
alt stavová backendová služba
  Compose -> Migration: start migrační quality gate
  Migration --> Compose: úspěch migrace
end
Host -> Compose: compose up -d --remove-orphans
Compose -> App: start nebo recreate kontejneru
@enduml
