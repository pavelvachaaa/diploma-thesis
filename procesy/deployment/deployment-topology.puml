@startuml
left to right direction
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false

actor "Uživatelé\n(uchazeči, HR, vedoucí, zaměstnanci)" as Users

package "Prezentační vrstva" {
  rectangle "kariera.kzcr.eu" as CAREER
  rectangle "onboarding.kzcr.eu" as ONBOARD
}

cloud "Publikační vrstva\n(reverzní proxy / URL routing)" as EDGE

node "Aplikační host" as APPHOST {
  package "Aplikační a integrační vrstva" {
    rectangle "hr-backend" as API
    rectangle "migration" as MIG
    rectangle "qualification-adapter" as QUAL
    rectangle "user-search-adapter" as USERSEARCH
    rectangle "audit_writer_processor" as AUDIT
    database "PostgreSQL\n(pgvector + Umami DB)" as DB
    rectangle "SeaweedFS\n(S3-compatible)" as S3
    queue "RabbitMQ" as MQ
    rectangle "Umami" as UMAMI
  }
}

node "Host vrstvy inteligentního\nzpracování dat" as AIHOST {
  package "Vrstva inteligentního\nzpracování dat" {
    rectangle "cv_processor" as CVP
    rectangle "job_processor" as JOBP
    rectangle "Apache Tika" as TIKA
    rectangle "Ollama\n(NVIDIA A10 24 GB)" as OLLAMA
  }
}

package "Dohledová vrstva" {
  rectangle "Promtail" as PT
  rectangle "Loki" as LOKI
  rectangle "Prometheus" as PROM
  rectangle "Grafana" as GRAF
}

Users --> CAREER
Users --> ONBOARD
CAREER --> EDGE
ONBOARD --> EDGE
EDGE --> API

CAREER ..> UMAMI : analytika
ONBOARD ..> UMAMI : analytika

MIG --> DB
API --> QUAL : HTTP
API --> USERSEARCH : HTTP
API --> DB
API --> S3
API <--> MQ
AUDIT --> MQ : consume audit.event
AUDIT --> DB : insert audit_events

API <--> JOBP : HTTP/SSE
CVP <--> MQ : async events
CVP --> S3 : download CV
CVP --> TIKA : extract text
CVP --> OLLAMA : analýza + embedding
JOBP --> OLLAMA : generace textu

APPHOST ..> PT : logy
AIHOST ..> PT : logy
PT --> LOKI
PROM --> API : scrape /metrics
PROM --> MQ : exporter
PROM --> DB : exporter
PROM --> GRAF
LOKI --> GRAF

DB -[hidden]- MQ
CAREER -[hidden]- ONBOARD
@enduml
