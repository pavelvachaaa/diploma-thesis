@startuml
top to bottom direction
hide stereotype

skinparam backgroundColor transparent
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 20
skinparam defaultTextAlignment center
skinparam arrowFontSize 13
skinparam dpi 160
skinparam ranksep 32
skinparam nodesep 22
skinparam ArrowColor #475569
skinparam ArrowThickness 1.0
skinparam RoundCorner 14

skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}

skinparam rectangle<<frontend>> {
  BackgroundColor #EAF2FF
  BorderColor #2B5AA6
}

skinparam rectangle<<service>> {
  BackgroundColor #E8FFF8
  BorderColor #0F766E
}

skinparam rectangle<<external>> {
  BackgroundColor #F1F5F9
  BorderColor #64748B
}

skinparam rectangle<<obs>> {
  BackgroundColor #EEF2FF
  BorderColor #4F46E5
}

skinparam database {
  BackgroundColor #FFF3E0
  BorderColor #C97A10
  FontColor #7C2D12
}

skinparam folder {
  BackgroundColor #FFF3E0
  BorderColor #C97A10
  FontColor #7C2D12
}

skinparam queue {
  BackgroundColor #FFF3E0
  BorderColor #C97A10
  FontColor #7C2D12
}

rectangle "Implementační pohled platformy náboru a adaptace KZ" {
  package "Klientské aplikace" {
    together {
      rectangle "Kariérní portál" <<frontend>> as CareerFe
      rectangle "Administrační portál" <<frontend>> as AdminFe
      rectangle "Onboardingový portál" <<frontend>> as OnboardFe
    }
  }

  package "Transakční a integrační služby" {
    together {
      rectangle "Migrace schématu" <<service>> as Migration
      rectangle "hiring_backend" <<service>> as Backend
      rectangle "Interní integrační adaptéry" <<service>> as IntegrationAdapters
      rectangle "Auditní zapisovač" <<service>> as AuditWriter
    }
  }

  package "Datová a podpůrná vrstva" {
    together {
      database "PostgreSQL\n+ pgvector" as DB
      queue "RabbitMQ" as MQ
      folder "SeaweedFS" as S3
    }

    together {
      rectangle "AI procesory\n(cv_processor, job_processor)" <<service>> as AIProcessors
      rectangle "Ollama + Apache Tika" <<service>> as AICore
    }
  }
}

CareerFe --> Backend : HTTP
AdminFe --> Backend : HTTP
OnboardFe --> Backend : HTTP

Migration --> DB : SQL
Backend --> DB : SQL
Backend --> MQ : AMQP
Backend --> S3 : S3
Backend --> IntegrationAdapters : HTTP
Backend --> AIProcessors : HTTP / SSE

MQ --> AuditWriter : AMQP
AuditWriter --> DB : SQL

MQ --> AIProcessors : AMQP
AIProcessors --> S3 : S3
AIProcessors --> AICore : HTTP
AIProcessors --> MQ : AMQP

CareerFe -[hidden]right-> AdminFe
AdminFe -[hidden]right-> OnboardFe
Migration -[hidden]right-> Backend
Backend -[hidden]right-> IntegrationAdapters
IntegrationAdapters -[hidden]right-> AuditWriter
DB -[hidden]right-> MQ
MQ -[hidden]right-> S3
AIProcessors -[hidden]right-> AICore
@enduml
