@startuml
top to bottom direction
hide stereotype

skinparam backgroundColor transparent
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultTextAlignment center
skinparam dpi 160
skinparam ranksep 26
skinparam nodesep 28
skinparam ArrowColor #475569
skinparam ArrowThickness 1.0
skinparam RoundCorner 14

skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}

skinparam rectangle<<frontend>> {
  BackgroundColor #EAF2FF
  BorderColor #2B5AA6
}

skinparam rectangle<<service>> {
  BackgroundColor #E8FFF8
  BorderColor #0F766E
}

skinparam rectangle<<external>> {
  BackgroundColor #F1F5F9
  BorderColor #64748B
}

skinparam rectangle<<obs>> {
  BackgroundColor #EEF2FF
  BorderColor #4F46E5
}

skinparam database {
  BackgroundColor #FFF3E0
  BorderColor #C97A10
  FontColor #7C2D12
}

skinparam folder {
  BackgroundColor #FFF3E0
  BorderColor #C97A10
  FontColor #7C2D12
}

skinparam queue {
  BackgroundColor #FFF3E0
  BorderColor #C97A10
  FontColor #7C2D12
}

skinparam actor {
  BorderColor #64748B
  FontColor #0F172A
}

actor "Uchazeč" as Candidate
actor "HR / vedoucí" as Hr
actor "Nový zaměstnanec" as Employee

rectangle "Implementační pohled platformy náboru a adaptace KZ" {
  package "Prezentační vrstva" {
    together {
      rectangle "Kariérní frontend" <<frontend>> as CareerFe
      rectangle "Administrační frontend" <<frontend>> as AdminFe
      rectangle "Onboarding frontend" <<frontend>> as OnboardFe
      rectangle "Umami" <<frontend>> as Umami
    }
  }

  package "Aplikační a integrační služby" {
    together {
      rectangle "migration" <<service>> as Migration
      rectangle "hiring_backend" <<service>> as Backend
      rectangle "qualification-adapter" <<service>> as Qualification
      rectangle "user-search-adapter" <<service>> as UserSearch
      rectangle "audit_writer_processor" <<service>> as AuditWriter
    }
  }

  package "Datová a messaging vrstva" {
    together {
      database "PostgreSQL\n+ pgvector" as DB
      folder "SeaweedFS" as S3
      queue "RabbitMQ" as MQ
    }
  }

  package "Vrstva inteligentního pracování" {
    together {
      rectangle "cv_processor" <<service>> as CvProcessor
      rectangle "job_processor" <<service>> as JobProcessor
      rectangle "Apache Tika" <<service>> as Tika
      rectangle "Ollama" <<service>> as Ollama
    }
  }

  package "Dohledová vrstva" {
    rectangle "Promtail • Loki • Prometheus • Grafana" <<obs>> as Observability
  }
}

rectangle "SSO / OIDC" <<external>> as SSO
rectangle "SMTP" <<external>> as SMTP
rectangle "IRIS / interní integrační vrstva" <<external>> as Iris
rectangle "NRZP / ÚZIS" <<external>> as Nrzp

Candidate --> CareerFe
Hr --> AdminFe
Employee --> OnboardFe

CareerFe --> Backend
AdminFe --> Backend
OnboardFe --> Backend

CareerFe ..> Umami : analytika
AdminFe ..> Umami : analytika
OnboardFe ..> Umami : analytika

Migration --> DB
Backend --> DB
Backend --> S3
Backend <--> MQ
Backend --> Qualification
Backend --> UserSearch
Backend --> JobProcessor : HTTP / SSE
Backend --> SSO
Backend --> SMTP

Qualification --> Iris
Qualification --> Nrzp
UserSearch --> Iris

MQ --> AuditWriter
AuditWriter --> DB

MQ --> CvProcessor
CvProcessor --> S3
CvProcessor --> Tika
CvProcessor --> Ollama
CvProcessor --> MQ

JobProcessor --> Ollama

Backend ..> Observability
CvProcessor ..> Observability
JobProcessor ..> Observability
MQ ..> Observability
DB ..> Observability

CareerFe -[hidden]right-> AdminFe
AdminFe -[hidden]right-> OnboardFe
OnboardFe -[hidden]right-> Umami
Migration -[hidden]right-> Backend
Backend -[hidden]right-> Qualification
Qualification -[hidden]right-> UserSearch
UserSearch -[hidden]right-> AuditWriter
DB -[hidden]right-> S3
S3 -[hidden]right-> MQ
CvProcessor -[hidden]right-> JobProcessor
JobProcessor -[hidden]right-> Tika
Tika -[hidden]right-> Ollama
SSO -[hidden]right-> SMTP
SMTP -[hidden]right-> Iris
Iris -[hidden]right-> Nrzp
@enduml
