FROM node:22-alpine AS builder

WORKDIR /app

ARG NEXT_PUBLIC_APP_VERSION
ARG NEXT_PUBLIC_BASE_API_URL_PROD
ARG NEXT_PUBLIC_REDIRECT_URI_PROD
ARG NEXT_PUBLIC_REGULAR_LOGIN_URL_PROD
ARG NEXT_PUBLIC_BASE_PATH

ENV NEXT_PUBLIC_APP_VERSION=$NEXT_PUBLIC_APP_VERSION
ENV NEXT_PUBLIC_BASE_API_URL_PROD=$NEXT_PUBLIC_BASE_API_URL_PROD
ENV NEXT_PUBLIC_REDIRECT_URI_PROD=$NEXT_PUBLIC_REDIRECT_URI_PROD
ENV NEXT_PUBLIC_REGULAR_LOGIN_URL_PROD=$NEXT_PUBLIC_REGULAR_LOGIN_URL_PROD
ENV NEXT_PUBLIC_BASE_PATH=$NEXT_PUBLIC_BASE_PATH

COPY package*.json ./

RUN npm ci

COPY . .

RUN npm run build

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=512"

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

EXPOSE 3000

CMD ["node", "server.js"]
