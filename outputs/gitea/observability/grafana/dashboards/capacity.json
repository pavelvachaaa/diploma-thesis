{
  "uid": "kz-capacity",
  "title": "Capacity — DB / Storage / Queue",
  "tags": ["kz", "capacity"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Postgres connections (used / max)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 9 },
      "targets": [
        { "expr": "sum(pg_stat_activity_count)", "legendFormat": "active", "refId": "A" },
        { "expr": "max(pg_settings_max_connections)", "legendFormat": "max", "refId": "B" }
      ]
    },
    {
      "type": "stat",
      "title": "Postgres database size (bytes)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 9 },
      "targets": [
        { "expr": "pg_database_size_bytes", "legendFormat": "{{datname}}", "refId": "A", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "RabbitMQ queue depth (messages ready)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 9 },
      "targets": [
        { "expr": "rabbitmq_queue_messages_ready", "legendFormat": "{{queue}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "SeaweedFS volume disk usage",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 9, "w": 12, "h": 9 },
      "targets": [
        {
          "expr": "1 - (SeaweedFS_volumeServer_disk_free_bytes / (SeaweedFS_volumeServer_disk_total_bytes > 0))",
          "legendFormat": "{{volume_server}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] }
    }
  ]
}
