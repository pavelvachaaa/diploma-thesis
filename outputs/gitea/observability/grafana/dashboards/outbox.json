{
  "uid": "kz-outbox",
  "title": "Outbox health",
  "tags": ["kz", "outbox"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Oldest pending age (s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "targets": [
        { "expr": "max(outbox_oldest_pending_age_seconds)", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 600 },
              { "color": "red", "value": 900 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Oldest processing age (s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "targets": [
        { "expr": "max(outbox_oldest_processing_age_seconds)", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 300 },
              { "color": "red", "value": 600 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Dead total",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "targets": [
        { "expr": "sum(outbox_rows_by_status{status=\"dead\"})", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Pending total",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "targets": [
        { "expr": "sum(outbox_rows_by_status{status=\"pending\"})", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Oldest age over time",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 9 },
      "targets": [
        { "expr": "outbox_oldest_pending_age_seconds", "legendFormat": "pending", "refId": "A" },
        { "expr": "outbox_oldest_processing_age_seconds", "legendFormat": "processing", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Rows by status (and event type)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 9 },
      "targets": [
        {
          "expr": "outbox_rows_by_status",
          "legendFormat": "{{status}} / {{event_type}}",
          "refId": "A"
        }
      ]
    }
  ]
}
